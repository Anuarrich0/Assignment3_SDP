@startuml
!pragma layout smetana
title Museum specimen accession — production classes
skinparam classAttributeIconSize 0
class Main {
  +{static} main(args: String[]): void
}
class IntakeService {
  -catalogs: Map<String, SpecimenCatalog>
  -workflows: Map<String, Function<SpecimenCatalog, Accession>>
  +admit(workflow: String, specimen: Specimen): String
}
abstract class Accession {
  #catalog: SpecimenCatalog
  +{abstract} admit(specimen: Specimen): String
}
class StandardAccession {
  +admit(specimen: Specimen): String
}
class QuarantineAccession {
  +admit(specimen: Specimen): String
}
interface SpecimenCatalog {
  +register(specimen: Specimen, quarantineDays: int): String
  +{static} validate(specimen: Specimen, days: int): void
}
class CentralCatalog {
  -entries: Map<String, Entry>
  +register(specimen: Specimen, days: int): String
}
class FieldJournal {
  -entries: List<Entry>
  +register(specimen: Specimen, days: int): String
}
class LegacyCatalogAdapter {
  -ledger: LegacyLedger
  -collection: String
  +register(specimen: Specimen, days: int): String
}
class "museum.legacy.LegacyLedger" as LegacyLedger {
  -entries: Map<Long, Entry>
  -online: boolean
  +accession(holdDays: int, description: byte[], number: long): int
}
class Specimen <<record>> {
  +collection(): String
  +inventoryId(): String
  +label(): String
  +key(): String
}
class CatalogException {
  -reason: Reason
  +reason(): Reason
}
enum "CatalogException.Reason" as Reason {
  INVALID_INPUT
  DUPLICATE
  UNAVAILABLE
  INTERNAL
}
Main ..> IntakeService : configures / calls
IntakeService --> "*" SpecimenCatalog : selects by collection
IntakeService ..> Accession : creates via registered function
Accession --> "1" SpecimenCatalog : bridge reference
StandardAccession --|> Accession
QuarantineAccession --|> Accession
CentralCatalog ..|> SpecimenCatalog
FieldJournal ..|> SpecimenCatalog
LegacyCatalogAdapter ..|> SpecimenCatalog
LegacyCatalogAdapter --> "1" LegacyLedger : wraps
SpecimenCatalog ..> Specimen : accepts
SpecimenCatalog ..> CatalogException : throws
CatalogException --> Reason
note bottom of LegacyLedger
  Frozen simulated legacy API. Nested Entry records
  and Java standard library types omitted for clarity.
end note
@enduml
